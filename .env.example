# CogDrift Environment Configuration

# Database Configuration
DATABASE_URL=postgresql+asyncpg://cogdrift:dev_only_change_me@postgres:5432/cogdrift

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Detector Configuration
BASELINE_WINDOW_DAYS=30
COLD_START_MIN_DAYS=14
TREND_Z_THRESHOLD=-2.0
TREND_PERSISTENCE_DAYS=3
ISOLATION_FOREST_CONTAMINATION=0.05

# JWT Authentication (Dev Secret Key)
JWT_SECRET=dev_jwt_secret_change_in_production_key_12345
